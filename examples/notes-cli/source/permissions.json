{
  "schemaVersion": 1,
  "policyVersion": 1,
  "defaultMode": "default",
  "codexApprovalPolicy": "on-request",
  "blockReadsOutsideWorkingDirectories": false,
  "additionalDirectories": [
    "~/projects"
  ],
  "runtimeDirectories": [
    "~/.claude",
    "~/.codex",
    "~/.gemini",
    "~/.cursor",
    "~/.config/opencode"
  ],
  "codexNetwork": {
    "enabled": false,
    "domains": {}
  },
  "codexShellEnvironment": {
    "passthrough": []
  },
  "allow": [
    "Read(~/projects/**)",
    "Bash(python3 -m pytest *)",
    "Bash(git status)",
    "Bash(git diff *)"
  ],
  "deny": [
    "Read(**/.env)",
    "Edit(**/.env)",
    "Bash(sudo *)"
  ],
  "ask": [
    "Bash(git push *)"
  ]
}
