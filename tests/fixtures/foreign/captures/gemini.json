{
  "hooks": {
    "AfterAgent": [
      {
        "hooks": [
          {
            "command": "reviewbot hook run --agent gemini '--source=reviewbot-hook'",
            "timeout": 10000,
            "type": "command"
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "hooks": [
          {
            "command": "reviewbot hook run --agent gemini '--source=reviewbot-hook'",
            "timeout": 10000,
            "type": "command"
          }
        ],
        "matcher": "run_shell_command"
      }
    ],
    "BeforeTool": [
      {
        "hooks": [
          {
            "command": "reviewbot hook run --agent gemini '--source=reviewbot-hook'",
            "timeout": 10000,
            "type": "command"
          }
        ],
        "matcher": "run_shell_command"
      }
    ]
  }
}
