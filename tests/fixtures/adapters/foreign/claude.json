{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "reviewbot hook run --agent claude '--source=reviewbot-hook'",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "reviewbot hook run --agent claude '--source=reviewbot-hook'",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "reviewbot hook run --agent claude '--source=reviewbot-hook'",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
